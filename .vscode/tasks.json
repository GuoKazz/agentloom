			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": []
		},
		{
			"label": "build: prod",
			"type": "npm",
			"script": "compile-web",
			"cwd": "${workspaceFolder}/apps/vscode-extension",
			"problemMatcher": ["$tsc", "$eslint-compact"],
