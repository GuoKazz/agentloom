{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev: webview",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@agentloom/webview-ui", "run", "dev"],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"group": "dev"
			}
		},
		{
			"label": "dev: extension",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@agentloom/vscode-extension", "run", "watch-web:rollup"],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"group": "dev"
			}
		},
		{
			"label": "dev: all",
			"dependsOn": ["dev: webview", "dev: extension"],
			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": []
		},
		{
			"label": "build: prod",
			"type": "shell",
			"command": "pnpm",
			"args": ["--filter", "@agentloom/vscode-extension", "run", "compile-web"],
			"problemMatcher": ["$tsc", "$eslint-compact"],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}