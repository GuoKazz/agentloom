{
  "name": "@agentloom/vscode-extension",
  "displayName": "AgentLoom",
  "description": "AgentLoom VS Code extension — agent platform embedded as a webview panel.",
  "version": "0.0.1",
  "publisher": "agentloom",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:agentloom.openWebview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentloom.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "agentloom.openWebview",
        "title": "Open AgentLoom Webview"
      }
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/test/suite/extensionTests.global.js",
    "pretest": "pnpm run compile-web",
    "vscode:prepublish": "pnpm run package-web",
    "build-webview": "pnpm --filter @agentloom/webview-ui build",
    "compile-web": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run build-webview",
    "package-web": "cross-env NODE_ENV=production pnpm run compile-web",
    "build": "tsup",
    "dev:bundle": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.138.0",
    "@vscode/test-web": "^0.0.81",
    "eslint": "^10.5.0",
    "mocha": "^11.7.6",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}