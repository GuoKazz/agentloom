{
  "name": "agentloom",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-plugin agent platform — a core node library plus shared packages powering agent software across web and plugin surfaces.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write --cache .",
    "lint": "eslint --cache .",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --parallel run dev:webview dev:extension",
    "dev:webview": "pnpm --filter @agentloom/webview-ui run dev",
    "dev:extension": "pnpm --filter @agentloom/vscode-extension run watch-web:rollup",
    "build:foo": "pnpm run -C packages/foo build",
    "test:foo": "pnpm run -C packages/foo test"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-rm": "^1.0.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
