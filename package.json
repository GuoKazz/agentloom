{
  "name": "agentloom",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-plugin agent platform — a core node library plus shared packages powering agent software across web and plugin surfaces.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write --cache .",
    "lint": "eslint --cache .",
    "typecheck": "pnpm -r run typecheck",
    "dev": "concurrently -n webview,extension -c blue,green npm:dev:webview npm:dev:extension",
    "dev:webview": "pnpm --filter @agentloom/webview-ui run dev",
    "dev:extension": "pnpm --filter @agentloom/vscode-extension run dev:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "concurrently": "^10.0.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
